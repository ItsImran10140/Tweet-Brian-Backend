    {
      "name": "3 Niche digest (what is happening in your field)",
      "item": [
        {
          "name": "3a. Safe preview (no LLM, nothing saved, no Parallel request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/digest/dry-run?niche=tech",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "digest",
                "dry-run"
              ],
              "query": [
                {
                  "key": "niche",
                  "value": "tech"
                }
              ]
            },
            "description": "Collects from feeds, GitHub and Hacker News, merges duplicates, applies trust tiers. Look at \"sources\" to see which feeds work, and \"preview\" for what would reach the LLM. Costs nothing."
          }
        },
        {
          "name": "3b. Safe preview INCLUDING Parallel search (uses 1-2 requests)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/digest/dry-run?niche=tech&include_search=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "digest",
                "dry-run"
              ],
              "query": [
                {
                  "key": "niche",
                  "value": "tech"
                },
                {
                  "key": "include_search",
                  "value": "1"
                }
              ]
            },
            "description": "Same as 3a but also calls Parallel once per search entry. Needs PARALLEL_API_KEY."
          }
        },
        {
