{
  "info": {
    "name": "Tweet Brain",
    "description": "Run the server (npm run dev), then go top to bottom: 0 Setup -> 1 Onboarding -> 2 Reference accounts -> 3 Niche digest -> 4 Tweets.\n\n'Create user' saves your userId automatically; every other request sends it in the x-user-id header.\nAdmin requests (folder 3) send x-admin-key: {{adminKey}}. Leave adminKey empty unless you set ADMIN_KEY in .env.\nChange {{baseUrl}} in the collection Variables tab if you use another port.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "adminKey",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "refId",
      "value": ""
    },
    {
      "key": "tweetId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 Setup",
      "item": [
        {
          "name": "Health (is the server up? which LLM?)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Test LLM keys (Gemini + OpenRouter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/llm/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "llm",
                "test"
              ]
            },
            "description": "Sends a tiny request to each configured provider. Tells you which key or model name is wrong."
          }
        },
        {
          "name": "Create user (saves userId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timezone\": \"Asia/Kolkata\",\n  \"daily_tweet_limit\": 10,\n  \"preferred_generation_time\": \"09:00\",\n  \"niche\": \"tech\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run this ONCE. It stores the id in {{userId}} for every other request. Replace your_x_handle with your own account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.id) { pm.collectionVariables.set('userId', j.id); console.log('userId saved:', j.id); }",
                  "pm.test('user created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Update my settings",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"daily_tweet_limit\": 10,\n  \"twitter_handle\": \"your_x_handle\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Overview (everything connected so far)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/overview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overview"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1 Onboarding (psychology questions)",
      "item": [
        {
          "name": "1a. Read the questions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/questions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "questions"
              ]
            }
          }
        },
        {
          "name": "1b. Get the fill-in template",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/template",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "template"
              ]
            },
            "description": "Returns every question with an id, how to answer it, and a 'body' you can copy into 1c."
          }
        },
        {
          "name": "1c. Save ALL answers (edit this body)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "draft"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"step\": \"all\",\n  \"answers\": {\n    \"persona\": {\n      \"q1\": \"TYPE YOUR ANSWER - what you do and your field\",\n      \"q2\": \"TYPE YOUR ANSWER - what you want to be known for online\",\n      \"q3\": \"TYPE YOUR ANSWER - your ideal reader\",\n      \"q4\": \"TYPE YOUR ANSWER - a belief most people in your field disagree with\",\n      \"q5\": \"TYPE YOUR ANSWER - one REAL story that shaped how you work\",\n      \"q6\": \"TYPE YOUR ANSWER - topics that are off-limits (comma separated)\",\n      \"q7\": \"TYPE YOUR ANSWER - words you never want to see (comma separated)\",\n      \"q8\": \"TYPE YOUR ANSWER - how competitive are you, and where does it show up\",\n      \"q9\": \"TYPE YOUR ANSWER - what you love reading or watching about\",\n      \"q10\": [\n        \"AI\",\n        \"Startups\",\n        \"Engineering\"\n      ]\n    },\n    \"thinking\": {\n      \"t1\": 3,\n      \"t2\": 3,\n      \"t3\": 3,\n      \"t4\": 3,\n      \"t5\": 3,\n      \"t6\": 3,\n      \"t7\": 3,\n      \"t8\": 3,\n      \"t9\": 3,\n      \"t10\": 3,\n      \"t11\": 3,\n      \"t12\": 3,\n      \"t13\": 3,\n      \"t14\": 3,\n      \"t15\": 3\n    },\n    \"voice\": {\n      \"v1\": \"A\",\n      \"v2\": \"A\",\n      \"v3\": \"A\",\n      \"v4\": \"A\",\n      \"v5\": \"A\",\n      \"v6\": \"A\",\n      \"v7\": \"A\",\n      \"v8\": \"A\"\n    },\n    \"lenses\": [\n      \"founder\",\n      \"engineer\"\n    ],\n    \"samples\": [\n      \"TYPE: one of your real past posts\",\n      \"TYPE: another real post\",\n      \"TYPE: a third real post\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Replace every 'TYPE ...' text. thinking: 1 (strongly disagree) to 5 (strongly agree). voice: 'A', 'B' or 'neither'. lenses: up to 2 from GET /template -> lens_options. You can send this in pieces; each save merges. The response shows progress and what is missing."
          }
        },
        {
          "name": "1c-alt. Save just the thinking section",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "draft"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"step\": \"thinking\",\n  \"answers\": {\n    \"thinking\": {\n      \"t1\": 5,\n      \"t2\": 2,\n      \"t3\": 4\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1d. Check progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/draft",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "draft"
              ]
            }
          }
        },
        {
          "name": "1e. (optional) Import samples from YOUR X account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/own-tweets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "own-tweets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"auto\",\n  \"limit\": 200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Needs twitter.x_bearer_token or twitter.twitterapi_io_key in config.yml. Uses the handle from 'Create user'. Replaces the 'samples' answers with your best recent posts. No key? Paste samples in 1c."
          }
        },
        {
          "name": "1f. Preview scores (no LLM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/score",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "score"
              ]
            }
          }
        },
        {
          "name": "1g. Build my profile (LLM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{userId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/synthesize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "synthesize"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 Reference accounts (whose style to borrow)",
      "item": [
