              "raw": "{\n  \"handle\": \"IndieHackers\",\n  \"admire_reason\": \"Short, punchy, practical lessons\",\n  \"text\": \"Paste tweet one here\\n---\\nPaste tweet two here\\n---\\nPaste tweet three here\",\n  \"analyze\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Copy 20+ tweets from the account's profile page, separate them with a line containing only ---. More tweets = better style match."
          },
          "event": [
            {
              "listen": "test",
              "script": {
