# Copy this file to  .env  (Windows: copy .env.example .env) and fill in what you have.
# Values in .env WIN over config.yml. Restart the server (npm run dev) after changing anything.

# ---- 0. Supabase (required for persistence + Auth) ----
# Project URL and service_role key from Supabase → Project Settings → API
# Backend only — never put the service_role key in frontend code.
# Frontend uses VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY (anon/publishable only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# App origin for CORS + OAuth redirects (also allowlists localhost automatically)
FRONTEND_URL=http://localhost:5173
# One-time JSON import (scripts/import-json.ts): your auth.users UUID after Google sign-in
IMPORT_USER_ID=
# Optional: which legacy db.json user id to copy from (defaults to the richest local user)
IMPORT_SOURCE_USER_ID=

# ---- 1. LLM (needed for real tweets) ----
# Gemini key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter key (free models, used as automatic fallback): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---- 2. News search (optional, free allowance 5,000 requests/month) ----
# Parallel key: https://platform.parallel.ai   (leave empty = the digest runs on feeds, Hacker News and GitHub only)
PARALLEL_API_KEY=
# Hard monthly stop for Parallel requests (default 4000)
PARALLEL_MONTHLY_CAP=

# ---- 3. Protect the admin endpoints (required for /api/admin/*, /api/llm/test, /api/dev/*) ----
# If unset, those routes stay closed (503). When set, send header: x-admin-key: <this value>
ADMIN_KEY=

# Optional rate limits (defaults are fine for free-plan multi-user)
# LIMITS_IP_PER_MINUTE=120
# LIMITS_API_PER_MINUTE=60

# ---- 4. Failure alerts (optional) ----
# Slack or Discord incoming-webhook URL
ALERT_WEBHOOK_URL=
# Telegram: create a bot with @BotFather, then message it and read your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 5. Optional: reading other people's tweets / X OAuth ----
X_BEARER_TOKEN=
TWITTERAPI_IO_KEY=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_TOKEN_ENCRYPTION_KEY=

# ---- 6. Polar payments (sandbox vs production via POLAR_ENVIRONMENT only) ----
# Docs: https://polar.sh/docs/integrate/sandbox  https://polar.sh/docs/integrate/oat
# https://polar.sh/docs/integrate/webhooks/delivery
# Create OAT in the SAME environment (sandbox.polar.sh vs polar.sh). Suggested scopes:
#   products:read, checkouts:read, checkouts:write, customer_sessions:write
# Local webhooks: polar webhook listen http://localhost:3001/webhooks/polar
# Verify config: npm run polar:diagnose
POLAR_ENVIRONMENT=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_LIFETIME_19=
POLAR_PRODUCT_LIFETIME_29=
POLAR_PRODUCT_MONTHLY=
POLAR_PRODUCT_YEARLY=
POLAR_SUCCESS_URL=

# ---- Other optional settings ----
LLM_PROVIDER=
LLM_FALLBACK_PROVIDER=
PORT=
FRONTEND_URL=
DIGEST_CRON=
CRON_ENABLED=
GENERATION_PIPELINE=
# Disk stage logs under data/generation-logs/. Default: on in development, OFF when NODE_ENV=production
# (Render free disk is ephemeral). Set true only if you explicitly want writes.
GENERATION_LOG_STAGES=
GENERATION_LOG_DIR=
DATA_FILE=
CONFIG_FILE=
