{
  "name": "tweet-brain",
  "version": "1.0.0",
  "description": "Tweet Brain: personality onboarding + reference Twitter accounts + a daily niche digest (feeds, Hacker News, GitHub, Parallel search) -> daily tweet drafts (Gemini / OpenRouter).",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "onboard": "tsx scripts/onboard.ts",
    "smoke": "tsx scripts/smoke.ts",
    "polar:diagnose": "tsx scripts/polar-diagnose.ts",
    "import-json": "tsx scripts/import-json.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test:pipeline": "tsx scripts/test-pipeline.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@polar-sh/sdk": "^1.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
